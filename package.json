{
  "name": "escala-cicc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "20.19.0",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:api:watch": "npm run dev:watch --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "seed:schedule": "npm run seed:schedule --workspace backend --",
    "migrate": "npm run migrate --workspace backend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
